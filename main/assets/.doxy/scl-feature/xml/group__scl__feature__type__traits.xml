      <memberdef kind="variable" id="group__scl__feature__type__traits_1gaaf37d54661f1f79920b8d49f84211649" prot="public" static="no" constexpr="yes" mutable="no">
        <templateparamlist>
          <param>
            <type>typename Expected</type>
          </param>
          <param>
            <type>typename Test</type>
          </param>
        </templateparamlist>
        <type>constexpr bool</type>
        <definition>constexpr bool scl::feature::is_compatible_with_v</definition>
        <argsstring></argsstring>
        <name>is_compatible_with_v</name>
        <qualifiedname>scl::feature::is_compatible_with_v</qualifiedname>
        <initializer>=
        (::std::is_same_v&lt;::std::remove_cv_t&lt;Expected&gt;, Expected&gt; &amp;&amp;
            ::std::is_same_v&lt;::std::remove_cv_t&lt;Test&gt;, Test&gt;)
        ? (::std::is_same_v&lt;Expected, Test&gt; || ::std::is_base_of_v&lt;Expected, Test&gt;)
        : is_compatible_with_v&lt;::std::remove_cv_t&lt;Expected&gt;, ::std::remove_cv_t&lt;Test&gt;&gt;</initializer>
        <briefdescription>
<para>Checks whether <computeroutput>Test</computeroutput> is compatible with (usable in place of) <computeroutput>Expected</computeroutput>. </para>
        </briefdescription>
        <detaileddescription>
<para>For non-wrapper types the check is: <computeroutput>Test</computeroutput> is the same type as <computeroutput>Expected</computeroutput>, or <computeroutput>Test</computeroutput> is publicly derived from <computeroutput>Expected</computeroutput>. For <computeroutput>wrapper</computeroutput> specializations that share the same template-template argument the check is applied recursively to their value types. cv-qualifiers are stripped from both arguments before the check.</para>
<para><parameterlist kind="templateparam"><parameteritem>
<parameternamelist>
<parametername>Expected</parametername>
</parameternamelist>
<parameterdescription>
<para>Target type. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>Test</parametername>
</parameternamelist>
<parameterdescription>
<para>Type to verify compatibility of.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<programlisting filename=".cpp"><codeline><highlight class="keyword">using<sp/></highlight><highlight class="normal"><ref refid="group__scl__feature__type__traits_1gae3debe73bc8e90f8ce2bdd90cd277113" kindref="member">P1</ref><sp/>=<sp/>wrapper&lt;int,<sp/><sp/><sp/><sp/>feature::inplace::plain&gt;;</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">using<sp/></highlight><highlight class="normal"><ref refid="group__scl__feature__type__traits_1gae3debe73bc8e90f8ce2bdd90cd277113" kindref="member">P2</ref><sp/>=<sp/>wrapper&lt;double,<sp/>feature::inplace::plain&gt;;</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">using<sp/></highlight><highlight class="normal"><ref refid="group__scl__feature__type__traits_1gae3debe73bc8e90f8ce2bdd90cd277113" kindref="member">U1</ref><sp/>=<sp/>wrapper&lt;int,<sp/><sp/><sp/><sp/>feature::inplace::uninitialized&gt;;</highlight></codeline>
<codeline><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">static_assert</highlight><highlight class="normal">(<sp/><ref refid="group__scl__feature__type__traits_1gae3debe73bc8e90f8ce2bdd90cd277113" kindref="member">is_compatible_with_v&lt;P1, P1&gt;</ref>);<sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>identical<sp/>types</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">static_assert</highlight><highlight class="normal">(!<ref refid="group__scl__feature__type__traits_1gae3debe73bc8e90f8ce2bdd90cd277113" kindref="member">is_compatible_with_v&lt;P1, P2&gt;</ref>);<sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>incompatible<sp/>value<sp/>types</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">static_assert</highlight><highlight class="normal">(!<ref refid="group__scl__feature__type__traits_1gae3debe73bc8e90f8ce2bdd90cd277113" kindref="member">is_compatible_with_v&lt;P1, U1&gt;</ref>);<sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>different<sp/>template<sp/>param</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">static_assert</highlight><highlight class="normal">(!<ref refid="group__scl__feature__type__traits_1gae3debe73bc8e90f8ce2bdd90cd277113" kindref="member">is_compatible_with_v&lt;int, P1&gt;</ref>);<sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>non-wrapper<sp/>vs<sp/>wrapper</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keyword">static_assert</highlight><highlight class="normal">(<sp/><ref refid="group__scl__feature__type__traits_1gae3debe73bc8e90f8ce2bdd90cd277113" kindref="member">is_compatible_with_v&lt;int, int&gt;</ref>);<sp/><sp/></highlight><highlight class="comment">//<sp/>same<sp/>non-wrapper<sp/>type</highlight></codeline>
</programlisting> </para>
        </detaileddescription>
