{
    "version": 4,
    "configurePresets": [
        {
            "name": "gcc-12-x64",
            "displayName": "GCC 12 (x64)",
            "description": "Pins a specific GCC install instead of whatever 'gcc' resolves to on PATH.",
            "inherits": "gcc-x64",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "/usr/bin/gcc-12",
                "CMAKE_CXX_COMPILER": "/usr/bin/g++-12"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "gcc-12-x64",
            "configurePreset": "gcc-12-x64",
            "inherits": "build-not-darwin"
        }
    ],
    "testPresets": [
        {
            "name": "gcc-12-x64",
            "configurePreset": "gcc-12-x64",
            "inherits": "test-not-darwin"
        }
    ]
}
