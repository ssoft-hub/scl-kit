@PACKAGE_INIT@

# Import exported targets for the ScL package
include("${CMAKE_CURRENT_LIST_DIR}/sclTargets.cmake")

# -----------------------------
# Components support
# -----------------------------
# Available components in this package (substituted from SCL_MODULES):
set(_scl_available_components @SCL_MODULES@)

# Mark requested components as FOUND if their targets exist.
# CMAKE_FIND_PACKAGE_NAME carries the exact name the consumer passed to
# find_package(), which is also the prefix of the _FIND_COMPONENTS /
# _<comp>_FOUND variables that check_required_components() inspects.
foreach(comp IN LISTS ${CMAKE_FIND_PACKAGE_NAME}_FIND_COMPONENTS)
    if (comp IN_LIST _scl_available_components AND TARGET scl::${comp})
        set(${CMAKE_FIND_PACKAGE_NAME}_${comp}_FOUND TRUE)
    else()
        set(${CMAKE_FIND_PACKAGE_NAME}_${comp}_FOUND FALSE)
    endif()
endforeach()

# Fail if REQUIRED components are missing
check_required_components(${CMAKE_FIND_PACKAGE_NAME})
