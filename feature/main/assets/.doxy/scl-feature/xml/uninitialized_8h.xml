        <name>SCL_EXECUTOR_CONSTRUCTOR_FOR_SELF_PROTOTYPE</name>
        <param><defname>cv_ref</defname></param>
        <initializer>    constexpr explicit uninitialized(self_type cv_ref other) noexcept \
    {                                                                 \
        for (::std::size_t i = 0; i &lt; sizeof(value_type); ++i)        \
            m_storage[i] = other.m_storage[i];                        \
    }</initializer>
