<parameternamelist>
<parametername>type</parametername>
</parameternamelist>
<parameterdescription>
<para>The unqualified wrapper class name. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>executor</parametername>
</parameternamelist>
<parameterdescription>
